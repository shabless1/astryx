// ASTRYX — Database schema (Directive v4.0 · Fix 1)
// Supabase Postgres via Prisma. NextAuth v4 standard models + Astryx models.
//
// DATABASE_URL  = pooled connection (Supavisor, port 6543, pgbouncer=true) — runtime queries
// DIRECT_URL    = session connection (port 5432) — migrations only

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── NextAuth v4 standard models (shapes per @next-auth/prisma-adapter) ───

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  // Astryx additions
  passwordHash  String?   // Credentials provider (bcryptjs)
  birthData     Json?     // natal input snapshot (name/date/time/location/coords)
  isPremium     Boolean   @default(false) // XRP legacy rail (dormant)
  // SUBSCRIPTION GATE v1 — the 30-day no-card trial clock, SERVER-side.
  // It used to live only in localStorage, which meant clearing site data (or a
  // second device) handed out a fresh 30 days. Claimed ONCE, atomically, and
  // never reset: see POST /api/subscription/status.
  trialStartedAt DateTime?
  // FUNNEL v1 — send-once stamps for the trial lifecycle mails. A stamp is the
  // dedupe: no stamp, no send, and the cron can run as often as it likes.
  trialEndingEmailAt DateTime?
  trialEndedEmailAt  DateTime?
  createdAt     DateTime  @default(now())

  accounts        Account[]
  sessions        Session[]
  readings        Reading[]
  chamberSessions ChamberSession[]
  consents        ConsentAcceptance[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Astryx models (Directive v4.0) ───────────────────────────────────────

// Access entitlement. Keyed by lowercase-normalized email so a Shopify order
// can grant access before the account exists.
//
// SUBSCRIPTION GATE v1 (2026-08-14) — one row PER PAID ORDER, append-only.
// Effective access = ANY active row that has not lapsed, so a renewal simply
// adds a row with a later period end and can never shorten what came before.
//   • currentPeriodEnd = NULL  → never expires (lifetime).
//   • currentPeriodEnd = date  → access dies at that date; a rebill extends it.
// SHA ruling 2026-08-14: the 10 founding fork buyers hold lifetime; every fork
// sold after FORK_LIFETIME_CUTOFF gets the standard 30-day trial instead.
model Entitlement {
  id                String    @id @default(cuid())
  email             String // ALWAYS lowercase-normalized before write
  source            String // "shopify_fork_kit" | "shopify_subscription" | "manual"
  plan              String    @default("lifetime") // "lifetime" | "monthly" | "yearly"
  shopifyOrderId    String?   @unique
  shopifyCustomerId String?
  status            String    @default("active")
  currentPeriodEnd  DateTime? // NULL = lifetime, never lapses
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @default(now()) @updatedAt

  @@index([email])
  @@index([email, status])
}

// FUNNEL v1 (2026-08-14) — every fork buyer, whether or not they ever made an
// account. The July briefing's #1 growth leak was that ~half of paying fork
// buyers never activated and nothing in the system knew who they were.
// Written by the Shopify orders/paid webhook, keyed by order so a retry can't
// double-send. `welcomeEmailAt` doubles as the send-once dedupe.
model BuyerLead {
  id             String    @id @default(cuid())
  email          String // ALWAYS lowercase-normalized before write
  name           String?
  product        String // "forks"
  shopifyOrderId String    @unique
  purchasedAt    DateTime
  welcomeEmailAt DateTime?
  createdAt      DateTime  @default(now())

  @@index([email])
}

// A persisted reading — the full deterministic ProtocolOutput + the intake
// that produced it. chartHash = stable hash of birth data + intake for
// determinism verification.
model Reading {
  id          String   @id @default(cuid())
  userId      String
  intake      Json
  protocol    Json // full ProtocolOutput
  chartData   Json? // /api/chart result (chart wheel + body map rehydration)
  accentColor String?
  chartHash   String
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model ChamberSession {
  id              String    @id @default(cuid())
  userId          String
  readingId       String?
  kind            String // "reading" | "daily"
  completedPhases Int       @default(0)
  startedAt       DateTime
  completedAt     DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// LEGAL SHIELD v1 · FIX 1 — informed-consent + assumption-of-risk record.
// One row per acceptance. When CONSENT_VERSION bumps, a returning user is
// re-prompted and a NEW row is written; old rows are retained (audit trail),
// never updated or deleted. `current consent` = a row whose consentVersion
// equals the app's CONSENT_VERSION constant (see src/legal/copy.ts).
model ConsentAcceptance {
  id              String   @id @default(cuid())
  userId          String
  consentVersion  String // matches src/legal CONSENT_VERSION at accept time
  acceptedAt      DateTime @default(now())
  ipAtAcceptance  String? // best-effort client IP captured server-side
  consentTextHash String? // sha256 of CONSENT_FULL_TEXT — proves WHAT was agreed

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consentVersion])
}
